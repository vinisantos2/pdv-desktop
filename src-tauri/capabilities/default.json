{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],

  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://firebasestorage.googleapis.com/**"
        }
      ]
    },
    "fs:default",
    "fs:allow-download-write"
  ]
}
